{
  "manifest_version": 3,
  "name": "AIUB Portal+ Enhanced",
  "short_name": "AIUB+",
  "description": "AIUB Student Portal enhancement suite with a full dark mode (Light/Dark/System), course filters, clash detection, grade analytics, schedule tools and UI improvements.",
  "version": "3.7.0",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://portal.aiub.edu/*",
    "https://aiub.edu/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "logo/icon16.png",
      "48": "logo/icon48.png",
      "128": "logo/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "logo/icon16.png",
    "48": "logo/icon48.png",
    "128": "logo/icon128.png"
  },
  "content_scripts": [
    {
      "js": [
        "assets/themeBridge.js-C7nNFON7.js",
        "assets/CaptchaSolver.js-loader-CoacijFS.js"
      ],
      "matches": [
        "https://portal.aiub.edu/",
        "https://portal.aiub.edu/?*",
        "https://portal.aiub.edu/Account/Login*",
        "https://portal.aiub.edu/Login*"
      ],
      "css": [
        "src/theme.css"
      ],
      "run_at": "document_idle"
    },
